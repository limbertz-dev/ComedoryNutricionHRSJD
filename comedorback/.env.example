# Copiar a .env y ajustar. .env no se sube al repositorio.
NOMBRE_APP=Sistema de Comedor y Nutricion Hospitalaria
ENTORNO=desarrollo

# Desde donde puede llamar el navegador, separado por comas. Sin esto el front
# no puede hablar con la API. En produccion va la direccion real del servidor.
ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:5173

# Base de desarrollo: copia de bd_turnos.sql, nunca la base viva del hospital.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bd_nutricion

# Base del modulo de turnos, del otro ingeniero. Este sistema SOLO la lee.
DB_NAME_TURNOS=bd_proyecto_backend

# SIH del hospital: SQL Server, base bdestadistica. SOLO LECTURA.
# Si se deja vacio, el modulo de pacientes arranca igual en modo manual.
# Ojo: la configuracion se cachea al arrancar. Despues de tocar esto hay que
# REINICIAR uvicorn — el --reload vigila archivos .py, no .env.
SIH_HOST=
SIH_PORT=1433
SIH_DATABASE=bdestadistica
SIH_USER=
SIH_PASSWORD=
