# Copiar a .env y ajustar. .env no se sube al repositorio.
NOMBRE_APP=Sistema de Comedor y Nutricion Hospitalaria
# produccion | desarrollo. Otro valor no arranca.
ENTORNO=desarrollo

# Desde donde puede llamar el navegador, separado por comas. Sin esto el front
# no puede hablar con la API. En produccion va la direccion real del servidor.
ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:5173

# Dos bases en el mismo servidor MySQL.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Base PROPIA del comedor: la administra alembic y scripts/recrear_bd_limpia.py
# la puede borrar entera.
DB_NAME=bd_nutricion
# Base del modulo de turnos (del otro ingeniero): SOLO LECTURA, a traves de las
# vistas v_* de DB_NAME. Nunca se escribe ni se altera.
DB_NAME_TURNOS=bd_proyecto_backend

# --- Autenticacion (ver app/core/seguridad.py) ---
# Firma de los tokens JWT, 32+ caracteres al azar. OBLIGATORIO si ENTORNO no es
# "desarrollo"; en desarrollo, si falta, se genera uno por arranque (las
# sesiones se pierden al reiniciar). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRETO=

# --- Lector biometrico (ver app/api/lector.py y lector_puente/) ---
# Un lector por entrada, nombre=clave, separados por ';'. El nombre (minusculas,
# numeros y guiones) queda en lecturas_biometricas.dispositivo. La clave, de 32+
# caracteres al azar, es la misma que va en el puente.ini de la PC de cocina.
# Vacio: ningun lector puede registrar lecturas. Generar la clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LECTORES=
