   "id": 1,
   "title": "Raciones de hoy",
   "type": "stat",
   "datasource": {
    "type": "mysql",
    "uid": "comedor-mysql"
   },
   "description": "Personal + policías, por fecha de la comida.",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "comedor-mysql"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT (SELECT COUNT(*) FROM asistencias WHERE fecha_comida = CURDATE()) + (SELECT COUNT(*) FROM raciones_policia WHERE fecha_comida = CURDATE()) AS raciones"
    }
   ],
   "options": {
