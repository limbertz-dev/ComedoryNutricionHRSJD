   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 9,
   "title": "Intervenciones de cocina por cocinera (periodo)",
   "type": "barchart",
   "datasource": {
    "type": "mysql",
    "uid": "comedor-mysql"
   },
   "description": "",
   "gridPos": {
    "x": 8,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "comedor-mysql"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT u.username AS cocinera, SUM(i.resultado = 'registrada') AS registradas, SUM(i.resultado = 'rechazada') AS rechazadas FROM intervenciones_lectura i JOIN usuarios_sistema u ON u.id = i.cuenta_id WHERE $__timeFilter(i.momento) GROUP BY u.username ORDER BY u.username"
    }
   ],
   "options": {
    "xField": "cocinera"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 10,
   "title": "Lecturas por lector (periodo)",
   "type": "table",
   "datasource": {
    "type": "mysql",
    "uid": "comedor-mysql"
   },
   "description": "",
   "gridPos": {
    "x": 16,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "comedor-mysql"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT dispositivo AS lector, COUNT(*) AS lecturas, SUM(resultado = 'aceptada') AS aceptadas, MAX(fecha_hora) AS ultima FROM lecturas_biometricas WHERE $__timeFilter(fecha_hora) GROUP BY dispositivo ORDER BY lecturas DESC"
    }
   ],
   "options": {},
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  }
 ],
 "description": "Solo lectura. Personal y policías se suman como en los informes de la app."
