  },
  {
   "id": 4,
   "title": "Minutos desde la última lectura",
   "type": "stat",
   "datasource": {
    "type": "mysql",
    "uid": "comedor-mysql"
   },
   "description": "Si sube durante un horario de comida, revisar el lector y el puente de cocina.",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "comedor-mysql"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT TIMESTAMPDIFF(MINUTE, GREATEST(COALESCE((SELECT MAX(fecha_hora) FROM lecturas_biometricas), '2000-01-01'), COALESCE((SELECT MAX(fecha_hora) FROM raciones_policia), '2000-01-01')), NOW()) AS minutos"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "m",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 60
       },
       {
        "color": "red",
        "value": 240
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "title": "Raciones por día",
   "type": "timeseries",
   "datasource": {
    "type": "mysql",
    "uid": "comedor-mysql"
   },
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "comedor-mysql"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT TIMESTAMP(r.fecha_comida) AS time, r.origen AS metric, COUNT(*) AS value FROM (SELECT fecha_comida, comida_id, categoria_reporte_id, 'Personal' AS origen FROM asistencias UNION ALL SELECT fecha_comida, comida_id, categoria_reporte_id, 'Policías' FROM raciones_policia) r WHERE $__timeFilter(r.fecha_comida) GROUP BY 1, 2 ORDER BY 1"
    }
   ],
   "options": {},
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 70,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "title": "Raciones por comida (periodo)",
   "type": "barchart",
   "datasource": {
    "type": "mysql",
    "uid": "comedor-mysql"
   },
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "comedor-mysql"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT c.nombre AS comida, SUM(r.origen = 'Personal') AS personal, SUM(r.origen = 'Policías') AS policias FROM (SELECT fecha_comida, comida_id, categoria_reporte_id, 'Personal' AS origen FROM asistencias UNION ALL SELECT fecha_comida, comida_id, categoria_reporte_id, 'Policías' FROM raciones_policia) r JOIN v_comidas c ON c.id = r.comida_id WHERE $__timeFilter(r.fecha_comida) GROUP BY c.id, c.nombre ORDER BY c.id"
    }
   ],
   "options": {
    "stacking": "normal",
    "xField": "comida"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 7,
   "title": "Raciones por columna del informe (periodo)",
   "type": "barchart",
   "datasource": {
    "type": "mysql",
    "uid": "comedor-mysql"
   },
   "description": "",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "comedor-mysql"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT cr.nombre AS columna, COUNT(*) AS raciones FROM (SELECT fecha_comida, comida_id, categoria_reporte_id, 'Personal' AS origen FROM asistencias UNION ALL SELECT fecha_comida, comida_id, categoria_reporte_id, 'Policías' FROM raciones_policia) r JOIN categorias_reporte cr ON cr.id = r.categoria_reporte_id WHERE $__timeFilter(r.fecha_comida) GROUP BY cr.id, cr.nombre, cr.orden ORDER BY cr.orden"
    }
   ],
   "options": {
    "xField": "columna"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 8,
   "title": "Lecturas rechazadas por motivo (periodo)",
   "type": "piechart",
   "datasource": {
    "type": "mysql",
    "uid": "comedor-mysql"
   },
   "description": "",
   "gridPos": {
    "x": 0,
