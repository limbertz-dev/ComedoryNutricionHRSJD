     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT COUNT(*) AS rechazadas FROM lecturas_biometricas WHERE resultado = 'rechazada' AND DATE(fecha_hora) = CURDATE()"
