     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT motivo, COUNT(*) AS lecturas FROM lecturas_biometricas WHERE resultado = 'rechazada' AND $__timeFilter(fecha_hora) GROUP BY motivo"
