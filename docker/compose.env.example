# Copiar a .env en la raíz del repositorio (no se sube a git) y completar.
# Generar claves con:  python -c "import secrets; print(secrets.token_urlsafe(32))"

MYSQL_ROOT_PASSWORD=
APP_DB_PASSWORD=
GRAFANA_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# 32+ caracteres al azar: firma de las sesiones.
AUTH_JWT_SECRETO=

# produccion | desarrollo
ENTORNO=produccion

# Nombres de las bases (los mismos que usa el hospital).
NUTRICION_DB=bd_nutricion
TURNOS_DB=bd_proyecto_backend

# API por el mismo nginx que sirve la web; requiere reconstruir el front.
API_URL_PUBLICA=/api
# Origen exacto de la web; en HTTPS: https://<nombre-del-servidor>.
ORIGENES_PERMITIDOS=http://localhost:8080,http://127.0.0.1:8080

# Lector biométrico: nombre=clave (32+), la misma clave en lector_puente/puente.ini.
LECTORES=

# Puertos publicados en la PC.
MYSQL_PUERTO=3307
FRONT_PUERTO=8080
GRAFANA_PUERTO=3000

# HTTPS: activar docker-compose.https.yml (publica 80 y 443).
# Certificado PEM con cadena completa y clave PEM sin contraseña.
# Debe cubrir el nombre del servidor y ser confiable en todas las PCs.
TLS_CERTIFICADO=./docker/front/certs/fullchain.pem
TLS_CLAVE_PRIVADA=./docker/front/certs/privkey.pem
