# Copiar a .env en la raíz del repositorio (no se sube a git) y completar.
# Generar claves con:  python -c "import secrets; print(secrets.token_urlsafe(32))"

MYSQL_ROOT_PASSWORD=
APP_DB_PASSWORD=
GRAFANA_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# 32+ caracteres al azar: firma de las sesiones.
AUTH_JWT_SECRETO=

# produccion | desarrollo
ENTORNO=produccion

# Nombres de las bases (los mismos que usa el hospital).
NUTRICION_DB=bd_nutricion
TURNOS_DB=bd_proyecto_backend

# Dirección de la API y del front vistas desde los navegadores del hospital.
# En una sola PC, localhost; en la red, la IP o nombre del servidor.
API_URL_PUBLICA=http://localhost:8000
ORIGENES_PERMITIDOS=http://localhost:8080,http://127.0.0.1:8080

# Lector biométrico: nombre=clave (32+), la misma clave en lector_puente/puente.ini.
LECTORES=

# Puertos publicados en la PC.
MYSQL_PUERTO=3307
API_PUERTO=8000
FRONT_PUERTO=8080
GRAFANA_PUERTO=3000
