# Copiar a puente.ini (no se sube al repositorio) y completar.

[api]
# Dirección de la API del comedor vista desde la PC de cocina.
url = http://127.0.0.1:8000
# La misma clave que figura para este lector en LECTORES del .env de la API
# (LECTORES=cocina-01=<esta clave>). 32+ caracteres.
clave =

[lector]
# zkteco:  ZK9500 / ZK4500 por USB (requiere el ZKFinger SDK y `pip install pyzkfp`).
# teclado: el lector escribe el número de usuario y Enter.
# prueba:  se escribe a mano; «-» simula una huella no reconocida.
adaptador = zkteco

[puente]
# Cuánto se reintenta un envío si la API no responde. Después se anota en
# pendientes.csv para registro manual de la jefatura.
reintentar_segundos = 120
pendientes = pendientes.csv
